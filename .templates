{
    "kaspad-public" : {
        "description" : "Public Node (default)",
        "modules":{
            "kaspad:public" : {
                "connectOnly" : true,
                "networkId" : "mainnet",
                "resolver" : null
            }
        }
    },
    "kaspad-local" : {
        "description" : "Local Node",
        "modules":{
            "kaspad:kd0" : {
                "reset-peers" : false,
                "binary" : "kaspad",
                "args":{
                    "rpclisten" : "0.0.0.0:16110",
                    "listen": "0.0.0.0:16111",
                    "rpclisten-borsh": "0.0.0.0:17110"
                }
            }
        }
    },
    "kaspad-local-miner" : {
        "description" : "Local Node + Miner",
        "modules":{
            "kaspad:kd0" : {
                "reset-peers" : false,
                "binary" : "kaspad",
                "args":{
                    "rpclisten" : "0.0.0.0:16110",
                    "listen": "0.0.0.0:16111",
                    "rpclisten-borsh": "0.0.0.0:17110"
                }
            },
            "kaspaminer:km0" : {
                "binary" : "kaspa-miner",
                "args":{}
            }
        }
    }
}
